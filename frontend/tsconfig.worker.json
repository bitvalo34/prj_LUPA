{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/worker/**/*.ts", "src/protocol/types.ts"]
}
